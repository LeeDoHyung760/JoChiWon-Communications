# Server runtime
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Provider selection: auto uses the real provider when its key exists, otherwise Mock.
AI_PROVIDER=auto
PLACE_PROVIDER=kakao

# OpenAI conversation analysis (secret key stays blank in this example)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=1

# Gemini greenhouse narrative generation (server-only secret)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kakao Local REST API (secret key stays blank in this example)
KAKAO_REST_API_KEY=
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_TIMEOUT_MS=10000

# Sejong public cultural-festival OpenAPI (server-only secret)
SEJONG_API_KEY=d237e52e1cd5d7389482932d9bd2eccd61f4011c0fd90051094807ae6f172f28
SEJONG_FESTIVAL_API_URL=http://apis.data.go.kr/5690000/sjFestival/sj_00000360
SEJONG_API_TIMEOUT_MS=10000
# Optional: when blank, SEJONG_API_KEY is reused.
TOUR_API_KEY=
TOUR_API_URL=http://apis.data.go.kr/B551011/KorService2/searchFestival2

# Kakao Login only; not required for Local place search
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=

# Recommendation limits and defaults
DEFAULT_SEARCH_REGION=조치원
DEFAULT_SEARCH_RADIUS_METERS=5000
RECOMMENDATION_RESULT_LIMIT=3
MAX_RECOMMENDATION_QUERY_LENGTH=300
MAX_ANALYSIS_MESSAGES=20

# Existing project provider settings
AUTH_PROVIDER=mock
LOCATION_PROVIDER=mock
DATABASE_PROVIDER=memory
ONSITE_SESSION_MINUTES=15

# Use safe Mock results if an external provider request fails.
ALLOW_MOCK_FALLBACK=true

# Optional in development: `npm run dev` starts an embedded local MongoDB.
# Required in production, where this should be a MongoDB Atlas or managed URI.
MONGODB_URI=
